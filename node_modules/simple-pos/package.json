{
  "name": "simple-pos",
  "version": "1.0.3",
  "description": "Simple POS Desktop Application for Retail & Food Shops",
  "main": "desktop/electron/main.js",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "build:frontend": "npm --prefix frontend run build",
    "dist:win": "set ELECTRON_BUILDER_COMPRESSION_LEVEL=1&& npm run build:frontend && electron-builder --win nsis",
    "dev:backend": "npm --prefix backend run dev",
    "dev:electron": "wait-on http://127.0.0.1:5173 http://127.0.0.1:5000/api/health && electron .",
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:electron\""
  },
  "build": {
    "appId": "com.simplepos.desktop",
    "productName": "Simple POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/electron/**/*",
      "frontend/dist/**/*",
      "build/icon.ico",
      ".env.example",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "src/**/*",
          "package.json"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "runtime",
        "to": "node",
        "filter": [
          "node.exe"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "pos",
    "electron",
    "sqlite",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  }
}
